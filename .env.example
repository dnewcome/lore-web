# Copy to .env (git-ignored) and edit. Used by deploy/deploy.sh to install
# and update lore-web on a host over ssh.
#
#   cp .env.example .env && $EDITOR .env
#   ./deploy/deploy.sh --units      # first time: install systemd units
#   ./deploy/deploy.sh              # thereafter: sync code + restart

# --- where to deploy ------------------------------------------------------
# ssh destination (a Host in ~/.ssh/config, or user@host)
DEPLOY_HOST=nas
# directory on that host holding server.py, plugins/ and the runtime env file
REMOTE_DIR=/srv/lore/web
# volume that must be mounted before the services start; leave empty to skip
# the check (set it when the data lives on a separate/removable disk)
DATA_MOUNT=/srv
# absolute paths on the host
LORESERVER_BIN=/usr/local/bin/loreserver
LORESERVER_CONFIG=/srv/lore/config
PYTHON_BIN=/usr/bin/python3

# --- runtime settings for lore-web ---------------------------------------
# deploy.sh writes nothing here; create $REMOTE_DIR/env on the host with
# these (note the `export` - the unit sources the file), then keep the
# secrets out of this repo:
#
#   export LORE_REMOTE=lore://127.0.0.1:41337
#   export LORE_PUBLIC_REMOTE=lore://your-host:41337
#   export CLONES_DIR=/srv/lore/web-clones
#   export PREVIEWS_DIR=/srv/lore/web-previews
#   export PREVIEW_ONLY=1
#   export PORT=41340
#   export LORE_WEB_AUTH=user:password
#   export FFMPEG=/usr/bin/ffmpeg
#   export FFPROBE=/usr/bin/ffprobe
