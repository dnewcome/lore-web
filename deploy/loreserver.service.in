[Unit]
Description=loreserver (Lore version control server)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
@MOUNT_GATE@
ExecStart=@LORESERVER_BIN@ --config @LORESERVER_CONFIG@
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loreserver

[Install]
WantedBy=default.target
